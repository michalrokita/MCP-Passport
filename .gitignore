# Dependencies
node_modules/

# Build output
out/
dist/
build/

# Release directory — only ship the Apple Silicon DMG so the website link works.
# Everything else (intel DMG, both .zips, unpacked .app dirs, blockmaps, yml) is local-only.
release/*
!release/MCP-Passport-mac-arm64.dmg

# TypeScript incremental build info
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Electron build artifacts (the released arm64 DMG above is re-allowed at the bottom)
*.app
*.dmg
*.exe
*.deb
*.AppImage

# Re-allow the one DMG we ship — must come AFTER *.dmg above.
!release/MCP-Passport-mac-arm64.dmg
