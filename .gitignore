# Dependencies
node_modules/

# Build output — never committed; CI publishes to GitHub Releases.
out/
dist/
release/

# `build/` holds electron-builder *input* resources (icon.icns, entitlements.plist,
# dmg-background.png) — those get committed. Ignore only generated artifacts inside.
build/icon-1024.png
build/icon.iconset/
build/mcp-passport.svg.png

# TypeScript incremental build info
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Electron build artifacts
*.app
*.dmg
*.exe
*.deb
*.AppImage
